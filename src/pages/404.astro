---
import { Undo2 } from "lucide-react";
import ButtonLink from "../components/ButtonLink";
import Layout from "../layouts/Layout.astro";
---

<!-- If using a layout component, wrap this content inside it -->
<Layout title="Page Not Found" lang="en">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-xl mx-auto space-y-6">
      <!-- Logo -->
      <a href="/" class="flex justify-center">
        <img
          src="/favicon.svg"
          alt="Spillingweb Logo"
          class="h-35 w-auto mb-10"
        />
      </a>
      
      <!-- Error Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink/10 border border-pink/20 text-pink text-sm font-medium">
        <span>Error 404</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-5xl md:text-7xl font-heading font-black tracking-tight leading-none">
        Page not found
      </h1>

      <!-- Description -->
      <p class="text-gray-400 text-lg">
        Oops! The page you are looking for on{" "}
        <span class="text-primary font-semibold">spillingweb.com</span> might
        have been removed, had its name changed, or is temporarily unavailable.
      </p>

      <!-- Action Button -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <ButtonLink href="/">
          Back to Homepage <Undo2 size={16} />
        </ButtonLink>
      </div>
    </div>
  </main>
</Layout>
