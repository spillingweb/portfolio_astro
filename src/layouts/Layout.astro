---
import "../styles/global.css";

interface Props {
  title: string;
  lang: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title,
  lang,
  description = "Spilling Web — Full-stack developer building accessible, understandable and production ready digital experiences.",
  image = "/favicon.svg",
  canonicalURL,
} = Astro.props;

const site = Astro.site ?? new URL("https://spillingweb.com/");
const normalizedCanonical = canonicalURL
  ? new URL(canonicalURL, site).toString()
  : new URL(Astro.url.pathname, site).toString();
const socialImage = new URL(image, site).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Spilling Web",
  url: site.toString(),
  sameAs: [
    "https://github.com/spillingweb",
    "https://linkedin.com/in/khspilling",
  ],
  jobTitle: "Full-stack developer",
  description,
  image: socialImage,
};
const alternateLanguages = [
  { href: "https://spillingweb.com/en/", lang: "en" },
  { href: "https://spillingweb.com/es/", lang: "es" },
  { href: "https://spillingweb.com/no/", lang: "no" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#8B1FFF" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Spilling Web" />
    <meta property="og:url" content={normalizedCanonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta
      property="og:locale"
      content={lang === "es" ? "es_ES" : lang === "no" ? "nb_NO" : "en_US"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={normalizedCanonical} />
    {alternateLanguages.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800;12..96,900&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>
