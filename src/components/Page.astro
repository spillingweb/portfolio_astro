---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import AboutSection from "./AboutSection.astro";
import SkillsSection from "./SkillsSection.astro";
import Layout from "../layouts/Layout.astro";
import HeroNav from "./HeroNav";
import FloatingMenu from "./FloatingMenu";
import ProjectList from "./ProjectList";
import type { Lang } from "../i18n/translations";
import { T } from "../i18n/translations";
import { islands } from "../lib/islands";
import { getAbout, getProjects, getSkills, getSettings } from "../lib/data";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = T[lang];
const langUrls = { en: "/en", es: "/es", no: "/no" };

const NAV_COLORS = [
  { color: "#FF3B6B", textColor: "white", href: "#work" },
  { color: "#F59A00", textColor: "#111118", href: "#about" },
  { color: "#00B896", textColor: "#111118", href: "#skills" },
  { color: "#1A0A2E", textColor: "white", href: "#contact" },
];

const navItems = NAV_COLORS.map((n, i) => ({
  ...n,
  label: [t.nav.work, t.nav.about, t.nav.skills, t.nav.contact][i],
}));

const aboutResult = await getAbout(lang);
const projectsResult = await getProjects();
const skillsResult = await getSkills();
const settingsResult = await getSettings();

const settings = settingsResult.data.settings;
const SKILLS = skillsResult.data.skills.items ?? [];
---

<Layout title={`${settings.studioName} — ${t.role}`} lang={lang}>
  <HeroNav
    client:load
    navItems={navItems}
    role={t.role}
    available={t.available}
    langUrls={langUrls}
    currentLang={lang}
  />

  <div class="grid grid-cols-3 h-1.5">
    <div class="bg-[#FF3B6B]"></div>
    <div class="bg-primary"></div>
    <div class="bg-accent"></div>
  </div>

  <!-- WORK -->
  <section id="work" class="py-28 max-w-7xl mx-auto px-6 md:px-12">
    <div
      class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6"
    >
      <div>
        <p
          class="font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground mb-3"
        >
          {t.work.label}
        </p>
        <h2
          class="font-heading font-black leading-[0.9] tracking-tight"
          style="font-size: clamp(2rem, 5vw, 4rem)"
        >
          {t.work.heading}
        </h2>
      </div>
      <a
        href={settings.githubUrl ?? "#"}
        class="hidden md:flex items-center gap-2 text-sm font-semibold text-muted-foreground hover:text-foreground transition-colors"
      >
        {t.work.github}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path
            d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
          ></path></svg
        >
      </a>
    </div>
    <ProjectList
      client:visible
      edges={projectsResult.data.projectConnection.edges}
      lang={lang}
    />
  </section>

  <!-- About section content -->
  <section id="about" class="py-28 bg-[#111118] text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <p
        class="font-mono text-xs uppercase tracking-[0.22em] text-white/30 mb-12"
      >
        {t.about.label}
      </p>
      <TinaIsland
        name="about"
        wrapper={islands.about.wrapper}
        params={{ lang }}
        primary
      >
        <AboutSection
          about={aboutResult.data.about}
          photoAlt={t.about.photoAlt}
        />
      </TinaIsland>
    </div>
  </section>

  <!-- Skills section content -->
  <section id="skills" class="py-28 max-w-7xl mx-auto px-6 md:px-12">
      <TinaIsland
        name="skills"
        wrapper={islands.skills.wrapper}
        params={{ lang }}
        >
            <SkillsSection
              skills={skillsResult.data.skills}
              label={t.skills.label}
              heading={t.skills.heading}
              lang={lang}
            />
      </TinaIsland>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-28 bg-[#FF3B6B]">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p
            class="font-mono text-xs uppercase tracking-[0.22em] text-foreground/40 mb-4"
          >
            {t.contact.label}
          </p>
          <h2
            class="font-heading font-black leading-[0.88] tracking-tight text-foreground whitespace-pre-line"
            style="font-size: clamp(3rem, 7vw, 6rem)"
          >
            {t.contact.heading}
          </h2>
          <p class="text-foreground/65 text-lg leading-relaxed max-w-sm mt-6">
            {t.contact.body}
          </p>
          <div class="mt-8 flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-[#22c55e] animate-pulse"
            ></span>
            <span class="font-mono text-xs text-foreground/60"
              >{t.contact.availability}</span
            >
          </div>
        </div>

        <div class="space-y-3">
          {
            [
              {
                icon: "mail",
                label: "Email",
                value: settings.email,
                href: `mailto:${settings.email}`,
              },
              {
                icon: "github",
                label: "GitHub",
                value: (settings.githubUrl ?? "#").replace("https://", ""),
                href: settings.githubUrl ?? "#",
              },
              {
                icon: "linkedin",
                label: "LinkedIn",
                value: (settings.linkedinUrl ?? "#").replace("https://", ""),
                href: settings.linkedinUrl ?? "#",
              },
            ].map((item) => (
              <a
                href={item.href}
                class="flex items-center gap-4 bg-foreground text-background p-5 rounded-sm hover:bg-foreground/85 transition-colors group"
              >
                <div class="w-10 h-10 bg-primary flex items-center justify-center shrink-0 rounded-sm">
                  {item.icon === "mail" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="white"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="20" height="16" x="2" y="4" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                  )}
                  {item.icon === "github" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="white"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  )}
                  {item.icon === "linkedin" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="white"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect width="4" height="12" x="2" y="9" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                  )}
                </div>
                <div class="min-w-0">
                  <p class="font-mono text-[10px] text-white/40 uppercase tracking-wider mb-0.5">
                    {item.label}
                  </p>
                  <p class="font-semibold text-sm truncate">{item.value}</p>
                </div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ml-auto text-white/25 group-hover:translate-x-1 transition-transform shrink-0"
                >
                  <>
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </>
                </svg>
              </a>
            ))
          }

          <div class="pt-2">
            <a
              href={`mailto:${settings.email}`}
              class="w-full flex items-center justify-center gap-2 bg-[#111118] text-white py-4 font-semibold rounded-sm hover:bg-[#111118]/85 transition-colors"
            >
              {t.contact.cta}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-border py-8 bg-background">
    <div
      class="max-w-7xl mx-auto px-6 md:px-12 flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <p class="font-heading font-bold text-sm">{settings.studioName}</p>
      <p class="font-mono text-[11px] text-muted-foreground text-center">
        © 2025 {settings.studioName}. {t.footer}
      </p>
      <div class="flex items-center gap-5">
        <div class="flex items-center gap-1">
          {
            (["en", "es", "no"] as const).map((l, i) => (
              <span class="flex items-center gap-1">
                {i > 0 && <span class="text-[10px] text-foreground/20">·</span>}
                <a
                  href={langUrls[l]}
                  class={`font-mono text-[11px] uppercase tracking-wider transition-colors ${
                    lang === l
                      ? "text-foreground font-bold"
                      : "text-muted-foreground hover:text-foreground"
                  }`}
                >
                  {l.toUpperCase()}
                </a>
              </span>
            ))
          }
        </div>
        {
          [
            { href: settings.githubUrl ?? "#", icon: "github" },
            { href: settings.linkedinUrl ?? "#", icon: "linkedin" },
            { href: `mailto:${settings.email}`, icon: "mail" },
          ].map(({ href, icon }) => (
            <a
              href={href}
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              {icon === "github" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
              )}
              {icon === "linkedin" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect width="4" height="12" x="2" y="9" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              )}
              {icon === "mail" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </footer>

  <FloatingMenu
    client:load
    navItems={navItems}
    role={t.role}
    langUrls={langUrls}
    currentLang={lang}
  />
</Layout>
