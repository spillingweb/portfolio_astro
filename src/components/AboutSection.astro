---
import { tinaField } from "@tinacms/astro/tina-field";
import { Image } from "astro:assets";

const { about, photoAlt } = Astro.props;

const isRemote = about.image?.startsWith("http");
---

<div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
  <!-- Profile photo -->
  <div class="relative">
    <div
      class="aspect-3/4 w-full max-w-sm mx-auto md:mx-0 bg-white/5 border border-white/10 rounded-sx flex flex-col items-center justify-center gap-4"
      aria-label={photoAlt}
    >
      <div class="absolute top-0 left-0 w-16 h-16 border-t-2 border-l-2 border-primary rounded-tl-sm"></div>
      <Image
        src={about.image}
        alt={photoAlt}
        inferSize={isRemote}
        width={isRemote ? undefined : 800}
        height={isRemote ? undefined : 1000}
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 800px"
        class="w-full h-full object-cover rounded-sx"
        data-tina-field={tinaField(about, "image")}
        loading="lazy"
        decoding="async"
        format="webp"
      />
    </div>
    <div class="absolute -right-3 top-8 bottom-8 w-1.5 bg-primary hidden md:block rounded-full"></div>
  </div>

  <!-- Editable text -->
  <div class="space-y-6 md:pt-4">
    <p
      class="text-white/75 leading-relaxed text-lg"
      data-tina-field={tinaField(about, "p1")}
    >
      {about.p1}
    </p>
    {about.p2 && (
      <p
        class="text-white/60 leading-relaxed"
        data-tina-field={tinaField(about, "p2")}
      >
        {about.p2}
      </p>
    )}
    {about.p3 && (
      <p
        class="text-white/60 leading-relaxed"
        data-tina-field={tinaField(about, "p3")}
      >
        {about.p3}
      </p>
    )}
    <div class="pt-4">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3.5 font-semibold rounded-sx hover:bg-[#7A1AE8] transition-colors"
        data-tina-field={tinaField(about, "cta")}
      >
        {about.cta}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
