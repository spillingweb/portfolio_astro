---
import { Image } from "astro:assets";
import { ArrowUpRight, ExternalLink } from "lucide-react";
import { tinaField } from "tinacms/dist/react";
import type { ProjectConnectionQuery } from "../../tina/__generated__/types";
import { GitHub } from "../lib/socialIcons";

type Edge = NonNullable<
  ProjectConnectionQuery["projectConnection"]["edges"]
>[number];

interface Props {
  edges: ProjectConnectionQuery["projectConnection"]["edges"];
  lang: "en" | "es" | "no";
}

const { edges, lang } = Astro.props;

const ACCENT_COLORS = ["#E8F5E9", "#FCE4EC", "#E3F2FD", "#FFF8E1", "#F3E5F5"];

const projects = (edges ?? [])
  .filter((e): e is NonNullable<Edge> => e !== null)
  .map((e) => e.node)
  .filter((n): n is NonNullable<typeof n> => n !== null)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<div class="mt-12 grid sm:grid-cols-2 gap-5">
  {
    projects.map((p, i) => {
      const description = p.descriptions?.[lang] ?? p.descriptions?.en ?? "";
      const accentColor = p.accentColor || ACCENT_COLORS[i % ACCENT_COLORS.length];

      return (
        <div class="group border border-border bg-card rounded-sx overflow-hidden flex flex-col hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
          {/* Accent bar */}
          <div
            class="h-0.75 shrink-0"
            style={{ background: accentColor }}
          />

          {/* Media */}
          <div
            class="relative overflow-hidden"
            style={{ height: "300px" }}
          >
            {p.image ? (
              <Image
                src={p.image}
                alt={p.title}
                width={800}
                height={600}
                inferSize={true}
                widths={[400, 800, 1200]}
                sizes="(max-width: 640px) 100vw, 50vw"
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                data-tina-field={tinaField(p, "image")}
              />
            ) : p.videoUrl ? (
              <video
                width="100%"
                preload="metadata"
                class="w-full h-full object-cover"
                muted
                autoplay
                loop
                playsinline
              >
                <source src={p.videoUrl} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            ) : null}

            <span class="absolute top-3 right-3 font-mono text-[10px] bg-black/55 text-white/80 px-2 py-1 rounded-sx backdrop-blur-sm">
              {p.year}
            </span>

            {p.videoUrl && (
              <div
                class="absolute inset-0 flex items-end p-3.5"
                data-tina-field={tinaField(p, "videoUrl")}
              >
                <span class="flex items-center gap-1.5 bg-black/65 text-white font-mono text-[10px] px-2.5 py-1 rounded-sx backdrop-blur-sm border border-white/10">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse shrink-0" />
                  Demo recording
                </span>
              </div>
            )}
          </div>

          {/* Body */}
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-baseline gap-3 min-w-0">
                <span class="font-mono text-xs text-muted-foreground/35 shrink-0">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3
                  class="font-heading font-black text-xl leading-tight truncate"
                  data-tina-field={tinaField(p, "title")}
                >
                  {p.title}
                </h3>
              </div>
              <ArrowUpRight
                size={17}
                className="text-muted-foreground/25 shrink-0 group-hover:text-foreground group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300 mt-0.5"
              />
            </div>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {p.tags &&
                p.tags.map((tag) => (
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded-sx bg-foreground/5 text-muted-foreground border border-border">
                    {tag}
                  </span>
                ))}
            </div>

            <p
              class="text-sm text-muted-foreground leading-relaxed flex-1"
              data-tina-field={tinaField(p, "descriptions")}
            >
              {description}
            </p>

            {(p.githubUrl || p.liveUrl) && (
              <div class="mt-5 pt-4 border-t border-border flex items-center gap-4">
                {p.githubUrl && (
                  <a
                    href={p.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
                    data-tina-field={tinaField(p, "githubUrl")}
                  >
                    <GitHub size={13} color="currentColor" /> GitHub
                  </a>
                )}
                {p.liveUrl && (
                  <a
                    href={p.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
                    data-tina-field={tinaField(p, "liveUrl")}
                  >
                    <ExternalLink size={13} /> Live Site
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      );
    })
  }
</div>