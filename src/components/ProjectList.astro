---
import { Image } from "astro:assets";
import { ExternalLink } from "lucide-react";
import { tinaField } from "tinacms/dist/react";
import type { ProjectConnectionQuery } from "../../tina/__generated__/types";
import { GitHub } from "../lib/socialIcons";
import type { Lang } from "../i18n/translations";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { islands } from "../lib/islands";
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";

interface Props {
  projectsData: ProjectConnectionQuery;
  lang: Lang;
}

const { projectsData, lang } = Astro.props;

const projects = projectsData?.projectConnection?.edges?.sort(
  (a, b) => (a?.node?.order || 0) - (b?.node?.order || 0),
);

if (!projects || projects.length === 0) {
  return null;
}
---

<TinaIsland
  name="projects"
  wrapper={islands.projects.wrapper}
  params={{ lang }}
>
  <div class="grid gap-5 min-h-fit">
    {projects?.map((p, i) => {
      const project = p?.node;
      if (!project) return null;
      const description =
        project.descriptions?.[lang] ?? project.descriptions?.en ?? "";
      const accentColor = project.accentColor;

      return (
        <div class="group border border-border bg-card rounded-xs overflow-hidden flex flex-col lg:flex-row hover:-translate-y-1 hover:shadow-xl transition-all duration-300 reveal-on-scroll">
          {/* Accent bar */}
          <div
            class="h-0.75 lg:h-full lg:w-1.5 shrink-0"
            style={{ background: accentColor }}
          />

          {/* Media */}
          <div class="relative overflow-hidden lg:max-w-[50%] h-80 lg:h-auto">
            {project.image ? (
              <Image
                src={project.image}
                alt={project.title}
                width={800}
                height={600}
                inferSize={true}
                widths={[400, 800, 1200]}
                sizes="(max-width: 640px) 100vw, 50vw"
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                data-tina-field={tinaField(project, "image")}
              />
            ) : project.videoUrl ? (
              <video
                width="100%"
                preload="metadata"
                class="w-full h-full object-cover"
                muted
                autoplay
                loop
                playsinline
              >
                <source src={project.videoUrl} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            ) : null}

            <span class="absolute top-3 right-3 font-mono text-[10px] bg-black/55 text-white/80 px-2 py-1 rounded-xs backdrop-blur-sm">
              {project.year}
            </span>

            {project.videoUrl && (
              <div
                class="absolute inset-0 flex items-end p-3.5"
                data-tina-field={tinaField(project, "videoUrl")}
              >
                <span class="flex items-center gap-1.5 bg-black/65 text-white font-mono text-[10px] px-2.5 py-1 rounded-xs backdrop-blur-sm border border-white/10">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse shrink-0" />
                  Demo recording
                </span>
              </div>
            )}
          </div>

          {/* Body */}
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-baseline gap-3 min-w-0">
                <span class="font-mono text-xs text-muted-foreground shrink-0">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3
                  class="font-heading font-black text-xl leading-tight truncate"
                  data-tina-field={tinaField(project, "title")}
                >
                  {project.title}
                </h3>
              </div>
            </div>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {project.tags &&
                project.tags.map((tag) => (
                  <span
                    class="font-mono text-[10px] px-2 py-0.5 rounded-xs bg-foreground/5 text-muted-foreground border border-border"
                    data-tina-field={tinaField(project, "tags")}
                  >
                    {tag}
                  </span>
                ))}
            </div>

            <div
              class="text-sm text-muted-foreground leading-relaxed flex-1 flex flex-col gap-2"
              data-tina-field={tinaField(project, "descriptions")}
            >
              <TinaMarkdown content={description} />
            </div>

            {(project.githubUrl || project.liveUrl) && (
              <div class="mt-5 pt-4 border-t border-border flex items-center gap-4">
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
                    data-tina-field={tinaField(project, "githubUrl")}
                  >
                    <GitHub size={13} color="currentColor" /> GitHub
                  </a>
                )}
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
                    data-tina-field={tinaField(project, "liveUrl")}
                  >
                    <ExternalLink size={13} /> Live Site
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>
</TinaIsland>
