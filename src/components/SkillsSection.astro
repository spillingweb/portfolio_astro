---
import { tinaField } from "@tinacms/astro/tina-field";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { islands } from "../lib/islands";
import { CodeXml, Layers, Zap } from "lucide-react";

const CARD_COLORS = [
  "var(--color-pink)",
  "var(--color-primary)",
  "var(--color-accent)",
];

const TAG_STYLES = [
  "border-primary/30 text-primary bg-primary/10",
  "border-pink/30 text-pink bg-pink/10",
  "border-accent/20 text-accent bg-accent/5",
];

interface TagItem extends Record<string, unknown> {
  name: string;
  group?: number | null;
}

interface ServiceLang extends Record<string, unknown> {
  title?: string | null;
  desc?: string | null;
}

interface ServiceItem {
  en?: ServiceLang | null;
  es?: ServiceLang | null;
  no?: ServiceLang | null;
}

interface Props {
  skills: {
    items?: (TagItem | null)[] | null;
    services?: (ServiceItem | null)[] | null;
  };
  label: string;
  heading: string;
  lang: "en" | "es" | "no";
}

const { skills, label, heading, lang } = Astro.props;
const items = (skills.items ?? []).filter((s): s is TagItem => s !== null);
const services = (skills.services ?? []).filter(
  (s): s is ServiceItem => s !== null,
);

// Precompute per-card data in frontmatter (avoids block bodies in template)
const cards = services.map((svc, i) => ({
  loc: svc[lang] ?? svc.en,
  svc,
  color: CARD_COLORS[i] ?? "var(--color-primary)",
  tagStyle: TAG_STYLES[i] ?? TAG_STYLES[0],
  tags: items.filter((s) => (s.group ?? 0) === i),
}));
---

<TinaIsland name="skills" wrapper={islands.skills.wrapper} params={{ lang }}>
  {
    <>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground mb-3">
        {label}
      </p>
      <h2
        class="font-heading font-black leading-[0.9] tracking-tight mb-16"
        style="font-size: clamp(2rem, 5vw, 4rem)"
      >
        {heading}
      </h2>

      <div class="grid md:grid-cols-3 gap-5">
        {cards.map((card, i) => {
          return (
            <div class="border border-border bg-card rounded-sm overflow-hidden flex flex-col">
              <div
                class="h-1 shrink-0"
                style={`background: ${card.color}`}
              ></div>

              <div class="p-8 flex flex-col flex-1">
                <!-- Icon -->
                <div
                  class="w-11 h-11 flex items-center justify-center mb-6 rounded-sm shrink-0"
                  style={`background: color-mix(in srgb, ${card.color} 18%, transparent)`}
                >
                  {i === 0 && <CodeXml color={card.color} size="20" />}
                  {i === 1 && <Layers color={card.color} size="20" />}
                  {i === 2 && <Zap color={card.color} size="20" />}
                </div>

                <!-- Title -->
                <h3
                  class="font-heading font-bold text-xl mb-3"
                  data-tina-field={tinaField(card.loc, "title")}
                >
                  {card.loc?.title}
                </h3>

                <!-- Description -->
                <p
                  class="text-sm text-muted-foreground leading-relaxed"
                  data-tina-field={tinaField(card.loc, "desc")}
                >
                  {card.loc?.desc}
                </p>
                <!-- Spacer pushes tags to bottom -->
                <div class="flex-1 min-h-6"></div>

                <!-- Divider -->
                <div class="border-t border-border mb-5"></div>

                <!-- Skill tags — same color as card -->
                <div class="flex flex-wrap gap-1.5">
                  {card.tags.map((s) => (
                    <span
                      class={`font-mono text-[10px] px-2.5 py-1 rounded-sm border ${TAG_STYLES[s.group ?? 0]}`}
                      data-tina-field={tinaField(s, "name")}
                    >
                      {s.name}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </>
  }
</TinaIsland>
