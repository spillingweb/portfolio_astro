---
import { ArrowRight, Mail } from "lucide-react";
import { GitHub, LinkedIn } from "../lib/socialIcons";
import type { Settings } from "../../tina/__generated__/types";
import type { Lang, Translations } from "../i18n/translations";
import ButtonLink from "./ButtonLink";

interface Props {
  settings: Settings;
  t: Translations;
}

const { settings, t } = Astro.props;
---

<div class="max-w-7xl mx-auto px-6 md:px-12">
  <div class="grid md:grid-cols-2 gap-16 items-center">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-white mb-4 anim-appear-left">
        {t.contact.label}
      </p>
      <h2
        class="font-heading font-black leading-[0.88] tracking-tight text-white whitespace-pre-line anim-appear-left"
        style="font-size: clamp(3rem, 7vw, 6rem)"
      >
        {t.contact.heading}
      </h2>
      <p class="text-white text-lg leading-relaxed max-w-sm mt-6">
        {t.contact.body}
      </p>
      <div class="mt-8 flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#22c55e] animate-pulse"></span>
        <span class="font-mono text-xs text-white">
          {t.contact.availability}
        </span>
      </div>
    </div>

    <div class="space-y-3">
      {[
        {
          icon: <Mail size={16} />,
          label: "Email",
          value: settings.email,
          href: `mailto:${settings.email}`,
        },
        {
          icon: <GitHub size={16} />,
          label: "GitHub",
          value: (settings.githubUrl ?? "#").replace("https://", ""),
          href: settings.githubUrl ?? "#",
        },
        {
          icon: <LinkedIn size={16} />,
          label: "LinkedIn",
          value: (settings.linkedinUrl ?? "#").replace("https://", ""),
          href: settings.linkedinUrl ?? "#",
        },
      ].map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 bg-foreground text-background p-5 rounded-xs hover:bg-foreground/85 transition-colors group anim-appear-right"
        >
          <div class="w-10 h-10 bg-primary flex items-center justify-center shrink-0 rounded-xs">
            {item.icon}
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-mono text-[10px] text-white/80 uppercase tracking-wider mb-0.5">
              {item.label}
            </p>
            <p class="font-semibold text-sm truncate">{item.value}</p>
          </div>
          <ArrowRight
            size={16}
            className="group-hover:translate-x-1 transition-transform text-muted-foreground"
          />
        </a>
      ))}

      <div class="pt-2">
        <ButtonLink href={`mailto:${settings.email}`} withArrow variant="secondary">
          {t.contact.cta}
        </ButtonLink>
      </div>
    </div>
  </div>
</div>
