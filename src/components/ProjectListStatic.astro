---
import type { ProjectConnectionQuery } from "../../tina/__generated__/types";
import { tinaField } from "@tinacms/astro/tina-field";

type Edge = NonNullable<ProjectConnectionQuery["projectConnection"]["edges"]>[number];

interface Props {
  edges: ProjectConnectionQuery["projectConnection"]["edges"];
  lang: "en" | "es" | "no";
}

const { edges, lang } = Astro.props;

const projects = (edges ?? [])
  .filter((e): e is NonNullable<Edge> => e !== null)
  .map((e) => e.node)
  .filter((n): n is NonNullable<typeof n> => n !== null)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<div class="mt-12 border-t border-border">
  {projects.map((p, i) => (
    <div class="relative border-b border-border py-7 md:py-8">
      <div class="flex flex-col md:flex-row md:items-center gap-4">
        <span
          class="font-heading font-black leading-none w-24 shrink-0"
          style={`font-size: clamp(2rem,4vw,3.5rem); color: ${p.accentColor ?? "#8B1FFF"}30`}
        >
          {String(i + 1).padStart(2, "0")}
        </span>
        <div class="flex-1 min-w-0">
          <h3
            class="font-heading font-black leading-none mb-2"
            style="font-size: clamp(1.5rem,3.5vw,2.5rem)"
            data-tina-field={tinaField(p, "title")}
          >
            {p.title}
          </h3>
          <p
            class="text-sm leading-relaxed max-w-lg text-muted-foreground"
            data-tina-field={tinaField(p.descriptions, lang)}
          >
            {p.descriptions?.[lang] ?? p.descriptions?.en ?? ""}
          </p>
        </div>
        <div class="flex flex-col items-start md:items-end gap-3 shrink-0 md:w-56">
          <div class="flex flex-wrap gap-1.5 md:justify-end">
            {(p.tags ?? []).filter(Boolean).map((tag) => (
              <span
                class="font-mono text-[10px] px-2 py-0.5 rounded-sm"
                style={`background: ${p.accentColor ?? "#8B1FFF"}18; color: ${p.accentColor ?? "#8B1FFF"}`}
              >
                {tag}
              </span>
            ))}
          </div>
          <span
            class="font-mono text-xs text-muted-foreground"
            data-tina-field={tinaField(p, "year")}
          >
            {p.year}
          </span>
        </div>
      </div>
    </div>
  ))}
</div>