---
import type { Project } from "../../tina/__generated__/types";

const { projects }: Record<string, Project[]> = Astro.props;

const ACCENT_COLORS = ["#E8F5E9", "#FCE4EC", "#E3F2FD", "#FFF8E1", "#F3E5F5"];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {projects.map((project, i) => {
    const accent = ACCENT_COLORS[i % ACCENT_COLORS.length];
    return (
      <article class="group rounded-2xl overflow-hidden border border-neutral-200 bg-white flex flex-col">
        <div class="relative aspect-video overflow-hidden bg-neutral-100">
          {project.isPrivate || !project.image ? (
            <div class="w-full h-full flex items-center justify-center bg-neutral-900 text-white text-sm font-medium tracking-wide">
              Demo recording
            </div>
          ) : (
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          )}
        </div>
        <div class="p-5 flex flex-col gap-3 flex-1">
          <h3 class="font-semibold text-lg leading-tight">{project.title}</h3>
          {project.tags && (
            <div class="flex flex-wrap gap-2 mt-auto pt-2">
              {project.tags.map((tag) => (
                <span
                  class="text-xs px-2 py-1 rounded-full font-medium"
                  style={`background-color: ${accent}`}
                >
                  {tag}
                </span>
              ))}
            </div>
          )}
          <div class="flex gap-3 pt-2">
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium underline underline-offset-2 hover:text-neutral-500 transition-colors"
              >
                GitHub
              </a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium underline underline-offset-2 hover:text-neutral-500 transition-colors"
              >
                Live site ↗
              </a>
            )}
          </div>
        </div>
      </article>
    );
  })}
</div>
